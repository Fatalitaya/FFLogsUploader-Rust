<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.3.0.0</Version>
    <PackageProjectUrl>https://github.com/yourusername/FFLogsPlugin</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DefaultItemExcludes>$(DefaultItemExcludes);worker/target/**;workers/**</DefaultItemExcludes>
    <CargoRoot Condition="'$(CARGO_HOME)' != ''">$(CARGO_HOME)</CargoRoot>
    <CargoRoot Condition="'$(CargoRoot)' == ''">$(UserProfile)/.cargo</CargoRoot>
    <WorkerTargetDir>$(CARGO_TARGET_DIR)</WorkerTargetDir>
    <!-- rusty_v8 requires symlink privileges when Cargo's registry and target are on different Windows drives. -->
    <WorkerTargetDir Condition="'$(WorkerTargetDir)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$([System.IO.Path]::GetPathRoot($(CargoRoot)))' != '$([System.IO.Path]::GetPathRoot($(MSBuildProjectDirectory)))'">$(CargoRoot)/fflogs-target/$([MSBuild]::StableStringHash('$(MSBuildProjectDirectory)'))</WorkerTargetDir>
    <WorkerTargetDir Condition="'$(WorkerTargetDir)' == ''">worker/target</WorkerTargetDir>
    <WorkerProfile Condition="'$(Configuration)' == 'Release'">release</WorkerProfile>
    <WorkerProfile Condition="'$(WorkerProfile)' == ''">debug</WorkerProfile>
    <WorkerExe>fflogs-worker</WorkerExe>
    <WorkerExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">fflogs-worker.exe</WorkerExe>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" WithCulture="false" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrebuiltWorkers)' == 'true'">
    <Content Include="workers/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrebuiltWorkers)' != 'true'">
    <Content Include="$(WorkerTargetDir)/$(WorkerProfile)/$(WorkerExe)" Link="workers/$(NETCoreSdkRuntimeIdentifier)/$(WorkerExe)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildParserWorker" BeforeTargets="PrepareForBuild" Condition="'$(PrebuiltWorkers)' != 'true'">
    <Exec Command="cargo build --target-dir &quot;$(WorkerTargetDir)&quot; --locked --manifest-path worker/Cargo.toml" Condition="'$(WorkerProfile)' == 'debug'" />
    <Exec Command="cargo build --target-dir &quot;$(WorkerTargetDir)&quot; --locked --release --manifest-path worker/Cargo.toml" Condition="'$(WorkerProfile)' == 'release'" />
  </Target>
</Project>
